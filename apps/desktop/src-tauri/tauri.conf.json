{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autonomous Studio Pro",
  "version": "1.0.0",
  "identifier": "com.autonomousstudio.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Autonomous Studio Pro — AI-Native Video Production Platform",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}

